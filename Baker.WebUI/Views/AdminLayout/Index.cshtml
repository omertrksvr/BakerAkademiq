@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="content-wrapper">
    <div class="page-header">
        <h3 class="page-title">
            <span class="page-title-icon bg-gradient-primary text-white me-2">
                <i class="mdi mdi-home"></i>
            </span> Panel
        </h3>
        <nav aria-label="breadcrumb">
            <ul class="breadcrumb">
                <li class="breadcrumb-item active" aria-current="page">
                    <span></span>Genel Bakış <i class="mdi mdi-alert-circle-outline icon-sm text-primary align-middle"></i>
                </li>
            </ul>
        </nav>
    </div>
    <div class="row">
        <div class="col-md-4 stretch-card grid-margin">
            <div class="card bg-gradient-danger card-img-holder text-white">
                <div class="card-body">
                    <img src="~/PurpleAdmin-Free-Admin-Template-1.0.0/assets/images/dashboard/circle.svg" class="card-img-absolute" alt="circle-image" />
                    <h4 class="font-weight-normal mb-3">Haftalık Satışlar <i class="mdi mdi-chart-line mdi-24px float-end"></i></h4>
                    <h2 class="mb-5">₺ 15.000</h2>
                    <h6 class="card-text">%60 Artış</h6>
                </div>
            </div>
        </div>
        <div class="col-md-4 stretch-card grid-margin">
            <div class="card bg-gradient-info card-img-holder text-white">
                <div class="card-body">
                    <img src="~/PurpleAdmin-Free-Admin-Template-1.0.0/assets/images/dashboard/circle.svg" class="card-img-absolute" alt="circle-image" />
                    <h4 class="font-weight-normal mb-3">Haftalık Siparişler <i class="mdi mdi-bookmark-outline mdi-24px float-end"></i></h4>
                    <h2 class="mb-5">45.633</h2>
                    <h6 class="card-text">%10 Düşüş</h6>
                </div>
            </div>
        </div>
        <div class="col-md-4 stretch-card grid-margin">
            <div class="card bg-gradient-success card-img-holder text-white">
                <div class="card-body">
                    <img src="~/PurpleAdmin-Free-Admin-Template-1.0.0/assets/images/dashboard/circle.svg" class="card-img-absolute" alt="circle-image" />
                    <h4 class="font-weight-normal mb-3">Çevrimiçi Ziyaretçi <i class="mdi mdi-diamond mdi-24px float-end"></i></h4>
                    <h2 class="mb-5">95.574</h2>
                    <h6 class="card-text">%5 Artış</h6>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-7 grid-margin stretch-card">
            <div class="card">
                <div class="card-body">
                    <div class="clearfix">
                        <h4 class="card-title float-start">Ziyaret ve Satış İstatistikleri</h4>
                        <div id="visit-sale-chart-legend" class="rounded-legend legend-horizontal legend-top-right float-end"></div>
                    </div>
                    <canvas id="visit-sale-chart" class="mt-4"></canvas>
                </div>
            </div>
        </div>
        <div class="col-md-5 grid-margin stretch-card">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">Trafik Kaynakları</h4>
                    <div class="doughnutjs-wrapper d-flex justify-content-center">
                        <canvas id="traffic-chart"></canvas>
                    </div>
                    <div id="traffic-chart-legend" class="rounded-legend legend-vertical legend-bottom-left pt-4"></div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-12 grid-margin">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">Son Talepler</h4>
                    <div class="table-responsive">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Sorumlu</th>
                                    <th>Konu</th>
                                    <th>Durum</th>
                                    <th>Son Güncelleme</th>
                                    <th>Takip No</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td><img src="~/PurpleAdmin-Free-Admin-Template-1.0.0/assets/images/faces/face1.jpg" class="me-2" alt="image"> David Grey</td>
                                    <td>Ödeme alınamadı</td>
                                    <td><label class="badge badge-gradient-success">TAMAMLANDI</label></td>
                                    <td>5 Ara 2017</td>
                                    <td>WD-12345</td>
                                </tr>
                                <tr>
                                    <td><img src="~/PurpleAdmin-Free-Admin-Template-1.0.0/assets/images/faces/face2.jpg" class="me-2" alt="image"> Stella Johnson</td>
                                    <td>Yüksek yüklenme süresi</td>
                                    <td><label class="badge badge-gradient-warning">DEVAM EDİYOR</label></td>
                                    <td>12 Ara 2017</td>
                                    <td>WD-12346</td>
                                </tr>
                                <tr>
                                    <td><img src="~/PurpleAdmin-Free-Admin-Template-1.0.0/assets/images/faces/face3.jpg" class="me-2" alt="image"> Marina Michel</td>
                                    <td>Site bir haftadır çalışmıyor</td>
                                    <td><label class="badge badge-gradient-info">BEKLEMEDE</label></td>
                                    <td>16 Ara 2017</td>
                                    <td>WD-12347</td>
                                </tr>
                                <tr>
                                    <td><img src="~/PurpleAdmin-Free-Admin-Template-1.0.0/assets/images/faces/face4.jpg" class="me-2" alt="image"> John Doe</td>
                                    <td>Sunucu kontrolü kaybedildi</td>
                                    <td><label class="badge badge-gradient-danger">REDDEDİLDİ</label></td>
                                    <td>3 Ara 2017</td>
                                    <td>WD-12348</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>